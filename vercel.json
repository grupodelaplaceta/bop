{
  "version": 2,
  "builds": [
    { "src": "api/cnic.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/cnic", "dest": "/api/cnic.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/favicon.ico", "dest": "/public/img/favibop.png" },
    { "src": "/normativa", "dest": "/public/normativa.html" },
    { "src": "/documento", "dest": "/public/documento.html" },
    { "src": "/cnic", "dest": "/public/cnic.html" },
    { "src": "/editar", "dest": "/public/editar.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
